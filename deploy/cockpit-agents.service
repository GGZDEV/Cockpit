[Unit]
Description=Cockpit autonomous agent gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Cockpit
EnvironmentFile=%h/.config/cockpit-agents.env
ExecStart=/usr/bin/env node agents-hub.cjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
