# Copié hors du dépôt dans ~/.config/cockpit/web.env
COCKPIT_SERVER_MODE=1
HOST=0.0.0.0
PORT=3888
# Noms/IP de la barre d’adresse, séparés par des virgules (sans schéma ni port).
COCKPIT_ALLOWED_HOSTS=192.168.1.10,cockpit.local
COCKPIT_WORKSPACES=/home/USER/Projets
COCKPIT_DEPLOYER_URL=http://192.168.1.236:8080
COCKPIT_DEPLOYER_TOKEN_FILE=/home/USER/.config/cockpit/deployer-token
COCKPIT_WEB_PASSWORD_FILE=/home/USER/.config/cockpit/web-password
# Dossier d’état hors du clone : secret des sessions (session-secret) et jeton HA (ha-session.json). Défaut : ~/.config/cockpit.
COCKPIT_STATE_DIR=/home/USER/.config/cockpit
COCKPIT_DIRECT=1
COCKPIT_CODEX_DIRECT=0
# Exécutions Claude Code/Codex simultanées sur ce PC (1 à 8, défaut 2).
#COCKPIT_MAX_PARALLEL=2
